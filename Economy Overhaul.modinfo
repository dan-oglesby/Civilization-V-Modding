  <Actions>
    <OnModActivated>
      <UpdateDatabase>XML/Buildings/BondExchange.xml</UpdateDatabase>
      <UpdateDatabase>XML/Buildings/CommodityExchange.xml</UpdateDatabase>
      <UpdateDatabase>XML/Buildings/GlobalStockMarket.xml</UpdateDatabase>
    </OnModActivated>
  </Actions>
  <EntryPoints>
