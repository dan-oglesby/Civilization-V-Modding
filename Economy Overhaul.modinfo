    <File md5="" import="1">UI/InGame/SovereignBondsPanel.lua</File>
    <File md5="" import="1">UI/InGame/SovereignBondsPanel.xml</File>
    <File md5="" import="1">UI/InGame/NetWorthPanel.lua</File>
    <File md5="" import="1">UI/InGame/NetWorthPanel.xml</File>
    <File md5="" import="1">UI/InGame/EconomyDashboardPanel.lua</File>
