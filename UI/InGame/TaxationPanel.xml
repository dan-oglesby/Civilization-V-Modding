<?xml version="1.0" encoding="utf-8"?>
<Context>

    <!-- Taxation / Fiscal Policy panel — Lord Mayors show/hide pattern. -->
    <Grid ID="TaxationPanel"
          Size="480,360"
          Anchor="C,C"
          Style="Grid9DetailFive140"
          ConsumeMouse="1">

        <Label String="FISCAL POLICY"
               Anchor="C,T" Offset="0,10" Font="TwCenMT18"
               Color0="30.50.80.255" Color1="133.184.186.255" Color2="133.184.186.255"
               FontStyle="SoftShadow"/>

        <Button ID="ClosePanelBtn" Size="32,32" Anchor="R,T" Offset="-4,4">
            <Label String="X" Font="TwCenMT16" Anchor="C,C" ColorSet="Beige_Black_Alpha"/>
            <ShowOnMouseOver>
                <AlphaAnim Anchor="C,C" Size="32,32" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
                    <Grid Size="32,32" Offset="0,0" Style="Grid9FrameTurnsHL"/>
                </AlphaAnim>
            </ShowOnMouseOver>
        </Button>

        <Label ID="IntroLabel" Size="450,40" Anchor="C,T" Offset="0,48"
               Font="TwCenMT14" ColorSet="Beige_Black_Alpha" WrapWidth="450" String=""/>

        <!-- Rate selector: − [ rate ] + -->
        <Box Anchor="C,T" Size="300,52" Offset="0,88" Color="0.0.0.128">
            <Button ID="RateDownBtn" Size="48,44" Offset="4,4" Anchor="L,T">
                <Label String="-" Font="TwCenMT18" Anchor="C,C" ColorSet="Beige_Black"/>
                <ShowOnMouseOver>
                    <AlphaAnim Anchor="C,C" Size="48,44" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
                        <Grid Size="48,44" Style="Grid9FrameTurnsHL"/>
                    </AlphaAnim>
                </ShowOnMouseOver>
            </Button>
            <Label ID="RateLabel" Size="180,44" Offset="60,4" Anchor="L,T" Font="TwCenMT18" ColorSet="Beige_Black_Alpha" String="0%"/>
            <Button ID="RateUpBtn" Size="48,44" Offset="248,4" Anchor="L,T">
                <Label String="+" Font="TwCenMT18" Anchor="C,C" ColorSet="Beige_Black"/>
                <ShowOnMouseOver>
                    <AlphaAnim Anchor="C,C" Size="48,44" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
                        <Grid Size="48,44" Style="Grid9FrameTurnsHL"/>
                    </AlphaAnim>
                </ShowOnMouseOver>
            </Button>
        </Box>

        <Image Anchor="C,T" Offset="0,152" Texture="HorizontalTrim.dds" Size="450,5"/>

        <Label ID="RevenueLabel" Size="450,30" Anchor="C,T" Offset="0,166"
               Font="TwCenMT14" ColorSet="Beige_Black_Alpha" WrapWidth="450" String=""/>
        <Label ID="CostLabel" Size="450,30" Anchor="C,T" Offset="0,200"
               Font="TwCenMT14" ColorSet="Beige_Black_Alpha" WrapWidth="450" String=""/>
        <Label ID="NoteLabel" Size="450,80" Anchor="C,T" Offset="0,238"
               Font="TwCenMT14" ColorSet="Beige_Black_Alpha" WrapWidth="450" String=""/>
    </Grid>

</Context>
