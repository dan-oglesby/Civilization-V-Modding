<?xml version="1.0" encoding="utf-8"?>
<Context>

    <!-- ============================================================
         National Treasury panel — centered modal, Lord Mayors pattern.
         No Hidden="1"; ContextPtr:SetHide(true) in Lua hides it at load.
         Shown via the Additional Information dropdown (top-right).
         ============================================================ -->
    <Grid ID="TreasuryPanel"
          Size="550,560"
          Anchor="C,C"
          Style="Grid9DetailFive140"
          ConsumeMouse="1">

        <Label String="NATIONAL TREASURY"
               Anchor="C,T" Offset="0,10" Font="TwCenMT18"
               Color0="30.50.80.255" Color1="133.184.186.255" Color2="133.184.186.255"
               FontStyle="SoftShadow"/>

        <!-- Close: hides the whole context via ContextPtr -->
        <Button ID="ClosePanelBtn" Size="32,32" Anchor="R,T" Offset="-4,4">
            <Label String="X" Font="TwCenMT16" Anchor="C,C" ColorSet="Beige_Black_Alpha"/>
            <ShowOnMouseOver>
                <AlphaAnim Anchor="C,C" Size="32,32" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
                    <Grid Size="32,32" Offset="0,0" Style="Grid9FrameTurnsHL"/>
                </AlphaAnim>
            </ShowOnMouseOver>
        </Button>

        <Box ID="TreasuryContent" Anchor="L,T" Size="530,510" Offset="10,40" Color="0.0.0.0">
            <Label String="BOND MARKET RATES" Offset="0,4" Font="TwCenMT16"
                   Color0="150.200.255.255" Color1="150.200.255.255" Color2="150.200.255.255"/>
            <Label ID="RatesLabel" Size="530,40" Offset="0,28" Font="TwCenMT14"
                   ColorSet="Beige_Black_Alpha" WrapWidth="530" String=""/>
            <Image Anchor="L,T" Offset="0,76" Texture="HorizontalTrim.dds" Size="530,4"/>
            <Label String="NATIONAL DEBT" Offset="0,88" Font="TwCenMT16"
                   Color0="255.150.150.255" Color1="255.150.150.255" Color2="255.150.150.255"/>
            <Label ID="DebtLabel" Size="530,80" Offset="0,112" Font="TwCenMT14"
                   ColorSet="Beige_Black_Alpha" WrapWidth="530" String=""/>
            <Image Anchor="L,T" Offset="0,200" Texture="HorizontalTrim.dds" Size="530,4"/>
            <Label String="BORROW" Offset="0,212" Font="TwCenMT16"
                   Color0="150.200.255.255" Color1="150.200.255.255" Color2="150.200.255.255"/>
            <Label ID="BorrowInfoLabel" Size="530,40" Offset="0,236" Font="TwCenMT14"
                   ColorSet="Beige_Black_Alpha" WrapWidth="530" String=""/>
            <Button ID="Borrow200Btn" Size="240,36" Offset="0,284"
                    ToolTip="Borrow 200 gold at the current debt rate.">
                <Label ID="Borrow200Label" String="Borrow 200 [ICON_GOLD]" Font="TwCenMT14" ColorSet="Beige_Black"/>
                <ShowOnMouseOver>
                    <AlphaAnim Anchor="C,C" Size="240,36" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
                        <Grid Size="240,36" Offset="0,0" Padding="0,0" Style="Grid9FrameTurnsHL"/>
                    </AlphaAnim>
                </ShowOnMouseOver>
            </Button>
            <Button ID="Borrow500Btn" Size="240,36" Offset="0,326"
                    ToolTip="Borrow 500 gold at the current debt rate.">
                <Label ID="Borrow500Label" String="Borrow 500 [ICON_GOLD]" Font="TwCenMT14" ColorSet="Beige_Black"/>
                <ShowOnMouseOver>
                    <AlphaAnim Anchor="C,C" Size="240,36" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
                        <Grid Size="240,36" Offset="0,0" Padding="0,0" Style="Grid9FrameTurnsHL"/>
                    </AlphaAnim>
                </ShowOnMouseOver>
            </Button>
            <Image Anchor="L,T" Offset="0,372" Texture="HorizontalTrim.dds" Size="530,4"/>
            <Label String="DEBT BURDEN" Offset="0,384" Font="TwCenMT16"
                   Color0="255.150.150.255" Color1="255.150.150.255" Color2="255.150.150.255"/>
            <Label ID="DebtBurdenLabel" Size="530,110" Offset="0,408" Font="TwCenMT14"
                   ColorSet="Beige_Black_Alpha" WrapWidth="530" String=""/>
        </Box>

    </Grid>

</Context>
