<?xml version="1.0" encoding="utf-8"?>
<Context>

    <!-- ============================================================
         National Treasury panel — centered modal, Lord Mayors pattern.
         No Hidden="1"; ContextPtr:SetHide(true) in Lua hides it at load.
         Shown via the Additional Information dropdown (top-right).
         Savings-side only: national loans / debt were removed from the mod.
         ============================================================ -->
    <Grid ID="TreasuryPanel"
          Size="550,350"
          Anchor="C,C"
          Style="Grid9DetailFive140"
          ConsumeMouse="1">

        <Label String="NATIONAL TREASURY"
               Anchor="C,T" Offset="0,10" Font="TwCenMT18"
               Color0="30.50.80.255" Color1="133.184.186.255" Color2="133.184.186.255"
               FontStyle="SoftShadow"/>

        <!-- Close: hides the whole context via ContextPtr -->
        <Button ID="ClosePanelBtn" Size="32,32" Anchor="R,T" Offset="-4,4">
            <Label String="X" Font="TwCenMT16" Anchor="C,C" ColorSet="Beige_Black_Alpha"/>
            <ShowOnMouseOver>
                <AlphaAnim Anchor="C,C" Size="32,32" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
                    <Grid Size="32,32" Offset="0,0" Style="Grid9FrameTurnsHL"/>
                </AlphaAnim>
            </ShowOnMouseOver>
        </Button>

        <Box ID="TreasuryContent" Anchor="L,T" Size="530,300" Offset="10,40" Color="0.0.0.0">

            <Label String="CAPITAL MARKET" Offset="0,4" Font="TwCenMT16"
                   Color0="150.200.255.255" Color1="150.200.255.255" Color2="150.200.255.255"/>
            <Label ID="RatesLabel" Size="530,44" Offset="0,28" Font="TwCenMT14"
                   ColorSet="Beige_Black_Alpha" WrapWidth="530" String=""/>

            <Image Anchor="L,T" Offset="0,80" Texture="HorizontalTrim.dds" Size="530,4"/>

            <Label String="YOUR TREASURY" Offset="0,92" Font="TwCenMT16"
                   Color0="150.255.180.255" Color1="150.255.180.255" Color2="150.255.180.255"/>
            <Label ID="TreasuryLabel" Size="530,44" Offset="0,116" Font="TwCenMT14"
                   ColorSet="Beige_Black_Alpha" WrapWidth="530" String=""/>

            <Image Anchor="L,T" Offset="0,168" Texture="HorizontalTrim.dds" Size="530,4"/>

            <Label String="HOW RATES MOVE" Offset="0,180" Font="TwCenMT16"
                   Color0="150.200.255.255" Color1="150.200.255.255" Color2="150.200.255.255"/>
            <Label ID="RateInfoLabel" Size="530,100" Offset="0,204" Font="TwCenMT14"
                   ColorSet="Beige_Black_Alpha" WrapWidth="530" String=""/>

        </Box>

    </Grid>

</Context>
