<?xml version="1.0" encoding="utf-8"?>
<Context>

    <!-- Sovereign Bonds panel — Lord Mayors show/hide pattern. -->
    <Grid ID="BondsPanel"
          Size="620,560"
          Anchor="C,C"
          Style="Grid9DetailFive140"
          ConsumeMouse="1">

        <Label String="SOVEREIGN BONDS"
               Anchor="C,T" Offset="0,10" Font="TwCenMT18"
               Color0="30.50.80.255" Color1="133.184.186.255" Color2="133.184.186.255"
               FontStyle="SoftShadow"/>

        <Button ID="ClosePanelBtn" Size="32,32" Anchor="R,T" Offset="-4,4">
            <Label String="X" Font="TwCenMT16" Anchor="C,C" ColorSet="Beige_Black_Alpha"/>
            <ShowOnMouseOver>
                <AlphaAnim Anchor="C,C" Size="32,32" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
                    <Grid Size="32,32" Offset="0,0" Style="Grid9FrameTurnsHL"/>
                </AlphaAnim>
            </ShowOnMouseOver>
        </Button>

        <Label ID="SummaryLabel" Size="600,38" Anchor="C,T" Offset="0,48"
               Font="TwCenMT14" ColorSet="Beige_Black_Alpha" WrapWidth="600" String=""/>

        <Box Anchor="L,T" Size="580,24" Offset="10,80" Color="0.0.0.128">
            <Label String="Nation"  Offset="4,2"   Size="176,20" Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
            <Label String="Yield"   Offset="184,2" Size="64,20"  Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
            <Label String="Price"   Offset="252,2" Size="70,20"  Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
            <Label String="Risk"    Offset="326,2" Size="72,20"  Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
            <Label String="Owned"   Offset="402,2" Size="44,20"  Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
            <Label String="Buy"     Offset="450,2" Size="60,20"  Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
            <Label String="Sell"    Offset="514,2" Size="60,20"  Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
        </Box>

        <Image Anchor="C,T" Offset="0,105" Texture="HorizontalTrim.dds" Size="600,5"/>

        <ScrollPanel ID="BondScroll" Size="600,396" Offset="10,110" Vertical="1" AutoScrollBar="1">
            <Stack ID="BondRowStack" Anchor="L,T" Size="580,0" StackGrowth="Bottom" Offset="0,0" Padding="5"/>
        </ScrollPanel>

        <Label ID="FooterLabel" Size="600,18" Anchor="C,B" Offset="0,8"
               Font="TwCenMT14" ColorSet="Beige_Black_Alpha" String=""/>
    </Grid>

    <Instance Name="BondRowInstance">
        <Box ID="RowRoot" Size="580,28" Color="0.0.0.45">
            <Label ID="CivName"   Size="176,26" Offset="4,2"   Font="TwCenMT14" ColorSet="Beige_Black_Alpha" TruncateWidth="176"/>
            <Label ID="BondYield" Size="64,26"  Offset="184,2" Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
            <Label ID="BondPrice" Size="70,26"  Offset="252,2" Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
            <Label ID="BondRisk"  Size="72,26"  Offset="326,2" Font="TwCenMT14"/>
            <Label ID="BondOwned" Size="44,26"  Offset="402,2" Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
            <Button ID="BuyBtn"  Size="60,26"  Offset="448,1">
                <Label String="Buy" Anchor="C,C" Font="TwCenMT14" ColorSet="Beige_Black"/>
                <ShowOnMouseOver>
                    <AlphaAnim Anchor="C,C" Size="60,26" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
                        <Grid Size="60,26" Style="Grid9FrameTurnsHL"/>
                    </AlphaAnim>
                </ShowOnMouseOver>
            </Button>
            <Button ID="SellBtn" Size="60,26"  Offset="512,1">
                <Label String="Sell" Anchor="C,C" Font="TwCenMT14" ColorSet="Beige_Black"/>
                <ShowOnMouseOver>
                    <AlphaAnim Anchor="C,C" Size="60,26" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
                        <Grid Size="60,26" Style="Grid9FrameTurnsHL"/>
                    </AlphaAnim>
                </ShowOnMouseOver>
            </Button>
        </Box>
    </Instance>

</Context>
