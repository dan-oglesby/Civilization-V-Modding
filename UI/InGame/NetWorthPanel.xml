<?xml version="1.0" encoding="utf-8"?>
<Context>

    <!-- Net Worth scoreboard — Lord Mayors show/hide pattern. -->
    <Grid ID="NetWorthPanel"
          Size="560,520"
          Anchor="C,C"
          Style="Grid9DetailFive140"
          ConsumeMouse="1">

        <Label String="ECONOMIC STANDING"
               Anchor="C,T" Offset="0,10" Font="TwCenMT18"
               Color0="30.50.80.255" Color1="133.184.186.255" Color2="133.184.186.255"
               FontStyle="SoftShadow"/>

        <Button ID="ClosePanelBtn" Size="32,32" Anchor="R,T" Offset="-4,4">
            <Label String="X" Font="TwCenMT16" Anchor="C,C" ColorSet="Beige_Black_Alpha"/>
            <ShowOnMouseOver>
                <AlphaAnim Anchor="C,C" Size="32,32" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
                    <Grid Size="32,32" Offset="0,0" Style="Grid9FrameTurnsHL"/>
                </AlphaAnim>
            </ShowOnMouseOver>
        </Button>

        <Label ID="BreakdownLabel" Size="520,52" Anchor="C,T" Offset="0,44"
               Font="TwCenMT14" ColorSet="Beige_Black_Alpha" WrapWidth="520" String=""/>

        <Box Anchor="L,T" Size="540,24" Offset="10,94" Color="0.0.0.128">
            <Label String="#"            Offset="4,2"   Size="36,20"  Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
            <Label String="Civilization" Offset="48,2"  Size="290,20" Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
            <Label String="Net Worth"    Offset="344,2" Size="190,20" Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
        </Box>

        <Image Anchor="C,T" Offset="0,119" Texture="HorizontalTrim.dds" Size="540,5"/>

        <ScrollPanel ID="RankScroll" Size="560,360" Offset="10,124" Vertical="1" AutoScrollBar="1">
            <Stack ID="RankRowStack" Anchor="L,T" Size="540,0" StackGrowth="Bottom" Offset="0,0" Padding="5"/>
        </ScrollPanel>

        <Label ID="FooterLabel" Size="540,18" Anchor="C,B" Offset="0,8"
               Font="TwCenMT14" ColorSet="Beige_Black_Alpha"
               String="Net worth = gold + stock portfolio + foreign bonds - national debt."/>
    </Grid>

    <Instance Name="RankRowInstance">
        <Box ID="RowRoot" Size="540,26" Color="0.0.0.45">
            <Label ID="RankNum"  Size="36,24"  Offset="4,2"   Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
            <Label ID="RankCiv"  Size="290,24" Offset="48,2"  Font="TwCenMT14" ColorSet="Beige_Black_Alpha" TruncateWidth="290"/>
            <Label ID="RankNW"   Size="190,24" Offset="344,2" Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
        </Box>
    </Instance>

</Context>
