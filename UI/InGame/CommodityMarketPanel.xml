<?xml version="1.0" encoding="utf-8"?>
<Context>

    <!-- Commodity Market panel — Lord Mayors show/hide pattern. -->
    <Grid ID="MarketPanel"
          Size="620,580"
          Anchor="C,C"
          Style="Grid9DetailFive140"
          ConsumeMouse="1">

        <Label String="COMMODITY MARKET"
               Anchor="C,T" Offset="0,10" Font="TwCenMT18"
               Color0="30.50.80.255" Color1="133.184.186.255" Color2="133.184.186.255"
               FontStyle="SoftShadow"/>

        <Button ID="CloseMarketBtn" Size="32,32" Anchor="R,T" Offset="-4,4">
            <Label String="X" Font="TwCenMT16" Anchor="C,C" ColorSet="Beige_Black_Alpha"/>
            <ShowOnMouseOver>
                <AlphaAnim Anchor="C,C" Size="32,32" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
                    <Grid Size="32,32" Offset="0,0" Style="Grid9FrameTurnsHL"/>
                </AlphaAnim>
            </ShowOnMouseOver>
        </Button>

        <Label ID="RateSummaryLabel"
               Size="600,20" Anchor="C,T" Offset="0,48"
               Font="TwCenMT14" ColorSet="Beige_Black_Alpha" WrapWidth="600" String=""/>

        <Button ID="AutoSellToggleBtn" Size="240,28" Offset="10,70" Anchor="L,T"
                ToolTip="When ON, every surplus resource is sold each turn automatically (keeps 1 of each luxury). Turn OFF to set amounts manually.">
            <Label ID="AutoSellBtnLabel" String="Sell All Surplus: OFF" Offset="0,0" Font="TwCenMT14" ColorSet="Beige_Black"/>
            <ShowOnMouseOver>
                <AlphaAnim Anchor="C,C" Size="240,28" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
                    <Grid Size="240,28" Offset="0,0" Padding="0,0" Style="Grid9FrameTurnsHL"/>
                </AlphaAnim>
            </ShowOnMouseOver>
        </Button>

        <Button ID="AutoBuyToggleBtn" Size="240,28" Offset="260,70" Anchor="L,T"
                ToolTip="When ON, automatically imports up to 1 of each resource you lack each turn — but only if another civilization is selling it. You can still set deeper imports manually.">
            <Label ID="AutoBuyBtnLabel" String="Auto-Buy to 1: OFF" Offset="0,0" Font="TwCenMT14" ColorSet="Beige_Black"/>
            <ShowOnMouseOver>
                <AlphaAnim Anchor="C,C" Size="240,28" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
                    <Grid Size="240,28" Offset="0,0" Padding="0,0" Style="Grid9FrameTurnsHL"/>
                </AlphaAnim>
            </ShowOnMouseOver>
        </Button>

        <Box Anchor="L,T" Size="580,24" Offset="10,102" Color="0.0.0.128">
            <Label String="Resource"   Offset="4,2"   Size="150,20" Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
            <Label String="Price"      Offset="158,2" Size="58,20"  Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
            <Label String="Trend"      Offset="220,2" Size="28,20"  Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
            <Label String="Have"       Offset="252,2" Size="46,20"  Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
            <Label String="Selling"    Offset="302,2" Size="50,20"  Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
            <Label String="Adjust"     Offset="356,2" Size="64,20"  Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
            <Label String="Gold/turn"  Offset="426,2" Size="148,20" Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
        </Box>

        <Image Anchor="C,T" Offset="0,127" Texture="HorizontalTrim.dds" Size="600,5"/>

        <ScrollPanel ID="MarketScroll" Size="600,400" Offset="10,132" Vertical="1" AutoScrollBar="1">
            <Stack ID="MarketRowStack" Anchor="L,T" Size="580,0" StackGrowth="Bottom" Offset="0,0" Padding="5"/>
        </ScrollPanel>

        <Label ID="FooterLabel" Size="600,18" Anchor="C,B" Offset="0,8"
               Font="TwCenMT14" ColorSet="Beige_Black_Alpha" String=""/>
    </Grid>

    <Instance Name="MarketRowInstance">
        <Box ID="RowRoot" Size="580,28" Color="0.0.0.45">
            <Label ID="ResName"    Size="150,26" Offset="4,2"   Font="TwCenMT14" ColorSet="Beige_Black_Alpha" TruncateWidth="150"/>
            <Label ID="ResPrice"   Size="58,26"  Offset="158,2" Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
            <Label ID="ResTrend"   Size="28,26"  Offset="220,2" Font="TwCenMT14"/>
            <Label ID="ResHave"    Size="46,26"  Offset="252,2" Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
            <Label ID="ResSelling" Size="50,26"  Offset="302,2" Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
            <Button ID="MinusBtn" Size="30,26" Offset="356,1" Anchor="L,T">
                <Label String="-" Anchor="C,C" Font="TwCenMT18" ColorSet="Beige_Black"/>
                <ShowOnMouseOver>
                    <AlphaAnim Anchor="C,C" Size="30,26" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
                        <Grid Size="30,26" Style="Grid9FrameTurnsHL"/>
                    </AlphaAnim>
                </ShowOnMouseOver>
            </Button>
            <Button ID="PlusBtn" Size="30,26" Offset="390,1" Anchor="L,T">
                <Label String="+" Anchor="C,C" Font="TwCenMT18" ColorSet="Beige_Black"/>
                <ShowOnMouseOver>
                    <AlphaAnim Anchor="C,C" Size="30,26" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
                        <Grid Size="30,26" Style="Grid9FrameTurnsHL"/>
                    </AlphaAnim>
                </ShowOnMouseOver>
            </Button>
            <Label ID="ResIncome"  Size="148,26" Offset="426,2" Font="TwCenMT14" ColorSet="Beige_Black_Alpha"/>
        </Box>
    </Instance>

</Context>
